# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------

# -----------------------------------------------------
# General
# -----------------------------------------------------
alias ..='cd ..'
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias ls='eza -a --icons=always'
alias ll='eza -al --icons=always'
alias lt='eza -a --tree --level=1 --icons=always'
alias shutdown='systemctl poweroff'
alias v='$EDITOR'
alias vim='$EDITOR'
alias wifi='nmtui'
alias arch-cleanup='~/.config/cyber/scripts/arch/cleanup.sh'
alias apps='~/.config/cyber/bin/cyber-apps.sh'
alias screenshot='~/.config/cyber/bin/cyber-screenshot.sh'
alias updates='~/.config/cyber/scripts/cyber-install-system-updates'
alias filemanager='~/.config/cyber/settings/filemanager'
alias lock='hyprlock'
alias clock='tty-clock'
alias system='~/.config/cyber/settings/systemmonitor'
alias quick='~/.config/cyber/bin/cyber-quicklinks.sh'
alias wallpaper='~/.config/cyber/bin/cyber-wallpaper.sh'



# -----------------------------------------------------
# Scripts
# -----------------------------------------------------
alias ascii='~/.config/cyber/scripts/cyber-ascii-header'

# -----------------------------------------------------
# System
# -----------------------------------------------------
alias update-grub='sudo grub-mkconfig -o /boot/grub/grub.cfg'

# -----------------------------------------------------
# Bat (cat replacement)
# -----------------------------------------------------
alias cat='bat'
alias less='bat --paging=always'
alias bathelp='bat --plain --language=help'
# pipe any command's --help through bat: e.g. help git
help() { "$@" --help 2>&1 | bathelp; }

# -----------------------------------------------------
# Zoxide (cd replacement)
# -----------------------------------------------------
eval "$(zoxide init zsh --cmd cd)"
