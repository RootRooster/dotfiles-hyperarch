name = Matugen
lookAndFeel = @@LAF@@
useDarkDefaults = @@DARK@@
[color]system.color.bg.view = {{colors.surface.default.hex}}
[color]system.color.fg.view = {{colors.on_surface.default.hex}}
[color]system.color.bg.control = {{colors.surface_container.default.hex}}
[color]system.color.fg.control = {{colors.on_surface.default.hex}}
[color]system.color.bg.selected.view = {{colors.primary_container.default.hex}}
[color]system.color.fg.selected.view = {{colors.on_primary_container.default.hex}}
[color]system.color.bg.border = {{colors.outline_variant.default.hex}}
[color]system.color.bg.tooltip = {{colors.surface_container_highest.default.hex}}
[color]system.color.fg.tooltip = {{colors.on_surface.default.hex}}
[color]system.color.fg.disabled = {{colors.outline.default.hex}}
color.bg.table.row.alt = {{colors.surface_container_low.default.hex}}
color.bg.currentline = {{colors.surface_container_high.default.hex}}
color.bg.selection = {{colors.secondary_container.default.hex}}
color.bg.highlight = {{colors.tertiary_container.default.hex}}
color.cursor.focused = {{colors.primary.default.hex}}
color.fg.listing.mnemonic = {{colors.primary.default.hex}}
color.fg.listing.function.name = {{colors.tertiary.default.hex}}
color.fg.listing.label.primary = {{colors.secondary.default.hex}}
color.fg.decompiler.keyword = {{colors.primary.default.hex}}
color.fg.decompiler.type = {{colors.secondary.default.hex}}
