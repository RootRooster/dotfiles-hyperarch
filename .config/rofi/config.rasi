/*
 * Cyber launcher — matches the Cyber waybar / power menu / lock screen.
 * Opened with Super+Space (~/.config/hypr/scripts/launcher.sh).
 * Previous ML4W version: config.rasi.bak
 */

configuration {
    modi:                  "drun,ai:~/.config/rofi/scripts/ai.sh,run,filebrowser,window";
    font:                  "JetBrainsMono Nerd Font 12";
    show-icons:            true;
    icon-theme:            "Colloid-Dark";
    display-drun:          "APPS";
    display-ai:            "AI";
    display-run:           "RUN";
    display-filebrowser:   "FILES";
    display-window:        "WINDOWS";
    drun-display-format:   "{name}<span foreground='#4a6b78' size='small'>  {generic}</span>";
    window-format:         "{w} · {c} · {t}";
    hover-select:          false;
    scroll-method:         1;
    me-select-entry:       "";
    me-accept-entry:       "MousePrimary";

    /* Vim-style navigation: Ctrl+j/k = down/up, Ctrl+h/l (or Tab / Shift+Tab) = previous/next tab.
       Ctrl+h/j/k/l are removed from rofi's defaults below so they don't clash. */
    kb-row-down:           "Down,Control+n,Control+j";
    kb-row-up:             "Up,Control+p,Control+k";
    kb-mode-previous:      "Shift+Left,Control+ISO_Left_Tab,Control+h,ISO_Left_Tab";
    kb-mode-next:          "Shift+Right,Control+Tab,Control+l,Tab";
    kb-accept-entry:       "Control+m,Return,KP_Enter";
    kb-remove-char-back:   "BackSpace,Shift+BackSpace";
    kb-remove-to-eol:      "";
    kb-mode-complete:      "";
    /* Tab / Shift+Tab switch tabs (APPS -> AI -> ...) instead of moving the selection */
    kb-element-next:       "";
    kb-element-prev:       "";
}

* {
    bg:          rgba(11, 16, 23, 0.95);
    bg-alt:      #0f1620;
    raise:       #162130;
    fg:          #c8f7ff;
    sub:         #8fb8c4;
    dim:         #4a6b78;
    accent:      #00f0ff;
    accent2:     #ff2bd6;
    alert:       #ff3355;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            46em;
    location:         center;
    anchor:           center;
    transparency:     "real";
    border:           1px 1px 1px 3px;
    border-color:     @accent;
    border-radius:    0;
    background-color: @bg;
}

mainbox {
    background-color: rgba(11, 16, 23, 0.85);
    padding:  1.1em;
    spacing:  0.9em;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* Search bar:  ❯ search…                                   APPS */
inputbar {
    padding:          0.7em 0.9em;
    spacing:          0.7em;
    background-color: @bg-alt;
    border:           0 0 1px 0;
    border-color:     @dim;
    children:         [ "textbox-arrow", "entry", "prompt" ];
}

textbox-arrow {
    expand:     false;
    str:        "❯";
    text-color: @accent2;
}

entry {
    placeholder:       "search…";
    placeholder-color: @dim;
    cursor:            text;
}

prompt {
    text-color: @dim;
}

message {
    padding:          0.4em 0.9em;
    background-color: @bg-alt;
    border:           0 0 0 2px;
    border-color:     @accent2;
}

textbox {
    text-color: @sub;
}

/* Results */
listview {
    lines:        9;
    columns:      1;
    dynamic:      true;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
    spacing:      0.15em;
}

element {
    padding:      0.45em 0.9em;
    spacing:      0.9em;
    border:       0 0 0 2px;
    border-color: transparent;
    cursor:       pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    text-color: @alert;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: rgba(0, 240, 255, 0.10);
    border-color:     @accent;
    text-color:       @accent;
}

element-icon {
    size:             1.5em;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    markup:           true;
}

/* Mode tabs along the bottom */
mode-switcher {
    spacing: 0.5em;
}

button {
    padding:          0.45em 0;
    background-color: @bg-alt;
    text-color:       @dim;
    border:           0 0 2px 0;
    border-color:     @raise;
    cursor:           pointer;
}

button selected {
    background-color: rgba(0, 240, 255, 0.08);
    text-color:       @accent;
    border-color:     @accent;
}

error-message {
    padding:          1em;
    background-color: @bg;
    border:           0 0 0 3px;
    border-color:     @alert;
}
