/*
 * Cyber clipboard history (Super+V) — ~/.config/ml4w/scripts/ml4w-cliphist
 * Cyber searchable menu (cyber-search.rasi) + image thumbnails.
 */

@import "~/.config/rofi/cyber-search.rasi"

configuration {
    show-icons:              true;
    kb-accept-alt:           "";
    kb-remove-char-forward:  "Delete";
}

window {
    width: 52em;
}

inputbar {
    children: [ "textbox-arrow", "entry" ];
}

entry {
    placeholder: "search clipboard…";
}

element {
    spacing: 0.9em;
}

element-icon {
    size:             1.7em;
    background-color: transparent;
}
