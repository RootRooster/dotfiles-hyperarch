#!/usr/bin/env bash
# Cyber clipboard history (Super+V). Everything you copy is recorded by
# `wl-paste --watch cliphist store` (Hyprland autostart); this lets you pick it again.
#
#   type            filter
#   Enter           copy the entry back to the clipboard
#   Shift+Enter     copy it and paste into the window you came from
#   Ctrl+D          delete the entry (menu stays open)
#   Ctrl+Shift+D    clear the whole history (asks first)
#   Ctrl+J/K, ↑/↓   move · Esc close
#
#   ml4w-cliphist     open the menu   (also: ml4w-cliphist d)
#   ml4w-cliphist w   clear the history (asks first)

THUMBS="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-thumbs"
mkdir -p "$THUMBS"

dim() { printf "<span foreground='#4a6b78'>%s</span>" "$1"; }

# Confirm and wipe the whole history
wipe() {
  local pick
  pick=$(printf '%s\n' "󰆴  Yes, clear all $(cliphist list | wc -l) entries" "󰜺  Cancel" |
    rofi -dmenu -config ~/.config/rofi/cyber-menu.rasi -format i -l 3 \
      -theme-str 'textbox-title { str: "󰅌  CLEAR CLIPBOARD HISTORY?"; } element selected.normal { border-color: #ff3355; text-color: #ff3355; background-color: rgba(255, 51, 85, 0.10); }' \
      -mesg "$(dim 'j/k move · l / Enter pick · q cancel')" \
      -kb-row-down "j,Down" -kb-row-up "k,Up" -kb-accept-entry "l,Return,KP_Enter" -kb-cancel "q,h,Escape")
  if [ "$pick" = "0" ]; then
    cliphist wipe
    rm -f "$THUMBS"/*.png
    notify-send -a "Clipboard" "Clipboard history cleared"
  fi
}

# Rows for rofi: "id<TAB>preview", with a thumbnail icon for images
rows() {
  cliphist list | while IFS=$'\t' read -r id preview; do
    if [[ "$preview" == "[[ binary data"*"png"* || "$preview" == "[[ binary data"*"jp"* ]]; then
      thumb="$THUMBS/$id.png"
      [ -f "$thumb" ] || printf '%s\t%s\n' "$id" "$preview" | cliphist decode |
        magick - -thumbnail 128x128 "$thumb" 2>/dev/null
      dims=$(grep -o '[0-9]*x[0-9]*' <<<"$preview")
      printf '%s\t󰋩  image %s\0icon\x1f%s\n' "$id" "$dims" "$thumb"
    else
      printf '%s\t%s\n' "$id" "$preview"
    fi
  done
}

menu() {
  local count
  count=$(cliphist list | wc -l)
  rows | rofi -dmenu -config ~/.config/rofi/config-clipboard.rasi -i \
    -display-columns 2 -display-column-separator $'\t' \
    -theme-str "textbox-title { str: \"󰅌  CLIPBOARD · $count\"; }" \
    -mesg "$(dim 'Enter copy · Shift+Enter paste · Ctrl+D delete · Ctrl+Shift+D clear all · Esc close')" \
    -kb-custom-1 "Shift+Return" -kb-custom-2 "Control+d" -kb-custom-3 "Control+Shift+d"
}

[ "$1" = "w" ] && { wipe; exit 0; }

source ~/.config/hypr/scripts/menu-toggle.sh; menu_toggle clipboard || exit 0   # Super+V again closes it

while true; do
  line=$(menu)
  code=$?
  case "$code" in
    0)   # Enter: copy
      [ -n "$line" ] && printf '%s' "$line" | cliphist decode | wl-copy
      exit 0 ;;
    10)  # Shift+Enter: copy and paste into the previous window
      [ -n "$line" ] || exit 0
      printf '%s' "$line" | cliphist decode | wl-copy
      sleep 0.2
      case "$(hyprctl activewindow -j | jq -r .class)" in
        kitty|*terminal*|Alacritty|foot|cyber-*) wtype -M ctrl -M shift v -m shift -m ctrl ;;
        *)                                       wtype -M ctrl v -m ctrl ;;
      esac
      exit 0 ;;
    11)  # Ctrl+D: delete entry, reopen
      [ -n "$line" ] && printf '%s' "$line" | cliphist delete
      rm -f "$THUMBS/${line%%$'\t'*}.png" ;;
    12)  # Ctrl+Shift+D: clear everything
      wipe; exit 0 ;;
    *)   exit 0 ;;
  esac
done
